# Port the API listens on
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/kopabridge

NODE_ENV=development

# Used to sign login JWTs (also reused, with a distinct payload shape and
# a much shorter expiry, to sign OAuth `state` tokens). Use a long,
# random value — do NOT reuse this example value.
JWT_SECRET=replace-with-a-long-random-secret

# Must be exactly 64 hex characters (32 bytes) — used by VaultService to
# AES-256-GCM encrypt provider access/refresh tokens at rest.
# Generate one with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Redis connection, used by BullMQ for background sync jobs
REDIS_HOST=localhost
REDIS_PORT=6379

# Comma-separated list of allowed CORS origins, e.g.:
# CORS_ORIGIN=https://app.kopabridge.com,https://staging.kopabridge.com
# Leave unset to disable cross-origin requests entirely.
CORS_ORIGIN=
