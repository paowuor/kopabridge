# Port the API listens on
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/kopabridge

NODE_ENV=development

# Used to sign login JWTs (also reused, with a distinct payload shape and
# a much shorter expiry, to sign OAuth `state` tokens). Use a long,
# random value — do NOT reuse this example value.
JWT_SECRET=replace-with-a-long-random-secret

# Must be exactly 64 hex characters (32 bytes) — used by VaultService to
# AES-256-GCM encrypt provider access/refresh tokens at rest.
# Generate a real one with: openssl rand -hex 32
# The value below is a DEV-ONLY placeholder so `docker compose up` works
# out of the box. Replace it with a freshly generated key for any shared,
# staging, or production environment. DO NOT reuse this value.
TOKEN_ENCRYPTION_KEY=599fe339969c6fbd4a8b6770533d7dbc62f15805af152b317ff072dcd7724b11

# Set to "true" only for non-production environments where the demo
# accounts (demo@kopabridge.com / admin@kopabridge.com) should be seeded.
# Never enable this in production.
SEED_DEMO_DATA=false

# Redis connection, used by BullMQ for background sync jobs
# Prefer a full Redis URL when using a hosted provider (Railway). Example:
# REDIS_URL=redis://:<password>@your-redis-host:6379
REDIS_URL=
# Fallback (local/docker):
REDIS_HOST=localhost
REDIS_PORT=6379

# Comma-separated list of allowed CORS origins, e.g.:
# CORS_ORIGIN=https://app.kopabridge.com,https://staging.kopabridge.com
# Leave unset to disable cross-origin requests entirely.
CORS_ORIGIN=

# Static bearer token protecting the Prometheus /metrics endpoint.
# When unset, /metrics rejects all requests. Generate with: openssl rand -hex 32
# METRICS_TOKEN=
